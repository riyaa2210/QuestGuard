# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://queueguard:queueguard@localhost:5432/queueguard
# Synchronous URL used by Alembic migrations only
SYNC_DATABASE_URL=postgresql+psycopg2://queueguard:queueguard@localhost:5432/queueguard

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Leave empty in local-dev mode; LocalStack or moto will be used instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS queue URLs (populated by Terraform outputs in production)
SQS_WEBHOOK_QUEUE_URL=http://localhost:4566/000000000000/queueguard-events
SQS_DLQ_URL=http://localhost:4566/000000000000/queueguard-events-dlq

# ── LocalStack (local dev) ─────────────────────────────────────────────────────
LOCALSTACK_ENDPOINT=http://localhost:4566   # set to empty string in production

# ── Delivery ──────────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=5
INITIAL_RETRY_DELAY_SECONDS=30   # first retry waits 30 s; doubles each attempt
DELIVERY_TIMEOUT_SECONDS=10

# ── LLM error explainer (optional) ────────────────────────────────────────────
OPENAI_API_KEY=                  # leave blank to disable the AI explainer
OPENAI_MODEL=gpt-4o-mini

# ── OpenTelemetry (optional) ───────────────────────────────────────────────────
OTEL_SDK_DISABLED=false          # set true to disable all tracing
OTEL_TRACES_EXPORTER=console     # console (dev) | otlp (production)
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:4317 for a local collector
